{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>belfry-project/.github"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Receptor image copied into the execution environment",
      "managerFilePatterns": [
        "/^execution-environment\\.yml$/"
      ],
      "matchStrings": [
        "(?<depName>ghcr\\.io/belfry-project/receptor):(?<currentValue>v[0-9.]+-belfry\\.[0-9]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "ansible-sign pinned to a commit on its main branch",
      "managerFilePatterns": [
        "/^execution-environment\\.yml$/"
      ],
      "matchStrings": [
        "git\\+(?<packageName>https://github\\.com/ansible/ansible-sign)@(?<currentDigest>[a-f0-9]{40})"
      ],
      "depNameTemplate": "ansible-sign",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "Base image of the execution environment",
      "managerFilePatterns": [
        "/^execution-environment\\.yml$/"
      ],
      "matchStrings": [
        "name: (?<depName>quay\\.io/almalinuxorg/almalinux):(?<currentValue>\\d+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?\\n"
      ],
      "datasourceTemplate": "docker",
      "autoReplaceStringTemplate": "name: {{depName}}:{{newValue}}{{#if newDigest}}@{{newDigest}}{{/if}}\n"
    },
    {
      "customType": "regex",
      "description": "Galaxy collections in the execution environment, pinned to exact versions",
      "managerFilePatterns": [
        "/^execution-environment\\.yml$/"
      ],
      "matchStrings": [
        "- name: (?<depName>[a-z0-9_]+\\.[a-z0-9_]+)\\n\\s+version: \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "galaxy-collection"
    },
    {
      "customType": "regex",
      "description": "awxkit from the latest Belfry release",
      "managerFilePatterns": [
        "/^execution-environment\\.yml$/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>belfry-project/belfry)/releases/download/(?<currentValue>[^/\\s]+)/awxkit-[^\\s]+\\.whl"
      ],
      "datasourceTemplate": "github-releases",
      "autoReplaceStringTemplate": "https://github.com/{{depName}}/releases/download/{{newValue}}/awxkit-{{newValue}}-py3-none-any.whl"
    },
    {
      "customType": "regex",
      "description": "Belfry's awx.awx collection from the latest Belfry release",
      "managerFilePatterns": [
        "/^execution-environment\\.yml$/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>belfry-project/belfry)/releases/download/(?<currentValue>[^/\\s]+)/awx-awx-[^\\s]+\\.tar\\.gz"
      ],
      "datasourceTemplate": "github-releases",
      "autoReplaceStringTemplate": "https://github.com/{{depName}}/releases/download/{{newValue}}/awx-awx-{{newValue}}.tar.gz"
    }
  ],
  "packageRules": [
    {
      "description": "Belfry's receptor rebuild is tagged <upstream version>-belfry.<n>",
      "matchPackageNames": [
        "ghcr.io/belfry-project/receptor"
      ],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-belfry\\.(?<build>\\d+)$"
    },
    {
      "description": "awxkit and the awx.awx collection come from the same Belfry release; update them together",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "belfry-project/belfry"
      ],
      "groupName": "Belfry release (awxkit and awx.awx)"
    }
  ]
}
