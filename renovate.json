{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>belfry-project/.github"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Receptor image copied into the execution environment",
      "managerFilePatterns": [
        "/^execution-environment\\.yml$/"
      ],
      "matchStrings": [
        "(?<depName>ghcr\\.io/belfry-project/receptor):(?<currentValue>v[0-9.]+-belfry\\.[0-9]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "ansible-sign pinned to a commit on its main branch",
      "managerFilePatterns": [
        "/^execution-environment\\.yml$/"
      ],
      "matchStrings": [
        "git\\+(?<packageName>https://github\\.com/ansible/ansible-sign)@(?<currentDigest>[a-f0-9]{40})"
      ],
      "depNameTemplate": "ansible-sign",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "Base image of the execution environment",
      "managerFilePatterns": [
        "/^execution-environment\\.yml$/"
      ],
      "matchStrings": [
        "name: (?<depName>quay\\.io/almalinuxorg/almalinux):(?<currentValue>\\d+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?\\n"
      ],
      "datasourceTemplate": "docker",
      "autoReplaceStringTemplate": "name: {{depName}}:{{newValue}}{{#if newDigest}}@{{newDigest}}{{/if}}\n"
    }
  ],
  "packageRules": [
    {
      "description": "Belfry's receptor rebuild is tagged <upstream version>-belfry.<n>",
      "matchPackageNames": [
        "ghcr.io/belfry-project/receptor"
      ],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-belfry\\.(?<build>\\d+)$"
    }
  ]
}
